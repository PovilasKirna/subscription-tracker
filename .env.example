# --- Required ---------------------------------------------------------------
# Password for the web UI (single user). Use something long.
APP_PASSWORD=change-me-to-a-long-passphrase
# Secret that signs the session cookie. Leave empty to auto-generate one into DATA_DIR. Or:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Optional ---------------------------------------------------------------
# Database. Leave unset for a local SQLite file in DATA_DIR (self-hosted / Docker).
# On Vercel set a Turso (libSQL) database — the Vercel Turso integration sets TURSO_* for you.
DATA_DIR=./data
# DATABASE_URL=libsql://<db>-<org>.turso.io
# DATABASE_AUTH_TOKEN=
# Set to true when served over HTTPS (reverse proxy / Tailscale serve / Cloudflare Tunnel)
COOKIE_SECURE=false
# Base currency used to sum totals in the dashboard.
BASE_CURRENCY=EUR

# --- Automatic sync via Enable Banking (optional, free for personal use) -----
# See README "Automatic sync". Leave empty to use CSV import only.
ENABLE_BANKING_APP_ID=
# Private key Enable Banking gave you: either a file path (self-hosted)…
ENABLE_BANKING_KEY_PATH=./data/enablebanking.pem
# …or the PEM contents in one variable (Vercel). Newlines may be written as 
.
# ENABLE_BANKING_PRIVATE_KEY=
# Must exactly match a redirect URL whitelisted on your Enable Banking app. Enable Banking only
# accepts https: locally run `npm run dev:https`; when hosted use your real https domain.
ENABLE_BANKING_REDIRECT_URL=https://localhost:3000/api/bank/callback
# How often to pull new transactions (hours). 0 disables the scheduler.
SYNC_INTERVAL_HOURS=12

# --- Vercel only ------------------------------------------------------------
# Random string; Vercel Cron sends it to /api/cron/sync. Required for scheduled syncs.
# CRON_SECRET=
