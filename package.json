{
  "name": "subscription-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted subscription tracker for Revolut (CSV import + optional Enable Banking sync)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning node_modules/next/dist/bin/next dev",
    "dev:https": "tsx scripts/dev-cert.ts && node --disable-warning=ExperimentalWarning node_modules/next/dist/bin/next dev --experimental-https --experimental-https-key certificates/localhost-key.pem --experimental-https-cert certificates/localhost.pem",
    "build": "next build",
    "start": "node --disable-warning=ExperimentalWarning node_modules/next/dist/bin/next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "tsx --conditions=react-server --test src/test/*.test.ts && tsx --test src/test/*.test.tsx",
    "sample": "tsx scripts/generate-sample.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "prepare": "husky",
    "mock:bank": "tsx scripts/mock-enablebanking.ts",
    "mock:t212": "tsx scripts/mock-trading212.ts",
    "anonymize": "tsx scripts/anonymize-export.ts",
    "vapid": "tsx scripts/vapid.ts",
    "email:dev": "email dev --dir src/emails --port 3001"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hono/node-server": "^2.1.3",
    "@libsql/client": "^0.18.0",
    "@tanstack/charts": "^1.0.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "d3-scale": "^4.0.2",
    "hono": "^4.13.13",
    "lucide-react": "^1.52.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.14",
    "nuqs": "^2.10.1",
    "react": "^19.3.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.0",
    "react-email": "^6.11.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@react-email/ui": "^6.11.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "husky": "^9.1.7",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
